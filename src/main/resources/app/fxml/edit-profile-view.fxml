<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="app.controllers.EditProfileController" styleClass="background">
    <VBox spacing="10" alignment="CENTER" prefWidth="550" prefHeight="750" styleClass="form-container">
        <!-- Horizontal Navigation -->
        <VBox spacing="10">
            <HBox spacing="10" styleClass="horizontal-menu">
                <Button text="Generátor" styleClass="menu-button" onAction="#onGoToMain"/>
                <Button text="Správce témat" styleClass="menu-button" onAction="#onGoToTopics"/>
                <Button text="Můj účet" styleClass="menu-button-active"/>
            </HBox>
        </VBox>

        <!-- Main content -->
        <VBox spacing="10" styleClass="form-container">
            <Text text="Váš účet" styleClass="heading"/>

            <HBox alignment="CENTER_RIGHT" maxWidth="350" styleClass="explanation-container">
                <Text text="* povinné pole" styleClass="explanation"/>
            </HBox>

            <TextField fx:id="firstName" promptText="Jméno" styleClass="input" maxWidth="350"/>
            <TextField fx:id="lastName" promptText="Příjmení" styleClass="input" maxWidth="350"/>
            <TextField fx:id="email" promptText="Email *" styleClass="input" maxWidth="350"/>
            <PasswordField fx:id="password" promptText="Heslo *" styleClass="input" maxWidth="350"/>
            <PasswordField fx:id="confirmPassword" promptText="Heslo znovu *" styleClass="input" maxWidth="350"/>
            <Text text="Heslo musí obsahovat alespoň 8 znáků, číslo, velké i malé písmeno a speciální znak."
                  styleClass="explanation" wrappingWidth="350" textAlignment="CENTER"/>
            <Text text="Vyberte vyučované předměty * (Ctrl + Klik)" styleClass="label"/>

            <ListView fx:id="subjects" maxWidth="350" styleClass="input-list-view"/>

            <Button fx:id="saveButton" text="Uložit údaje" onAction="#onSave" styleClass="submit" maxWidth="350"/>
        </VBox>
    </VBox>
</StackPane>