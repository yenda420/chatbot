<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="app.controllers.RegisterController" styleClass="background">
    <VBox spacing="10" alignment="CENTER" prefWidth="450" prefHeight="750">
        <Text text="Registrace" styleClass="heading"/>

        <Hyperlink text="Máte již účet? Přihlašte se." onAction="#onClickOnLoginLink" styleClass="register-link"/>

        <HBox alignment="CENTER_RIGHT" maxWidth="350" styleClass="explanation-container">
            <Text text="* povinné pole" styleClass="explanation"/>
        </HBox>

        <!-- Main content -->
        <VBox styleClass="register-form-container">
            <TextField fx:id="firstName" promptText="Jméno" styleClass="input" maxWidth="350"/>
            <TextField fx:id="lastName" promptText="Příjmení" styleClass="input" maxWidth="350"/>
            <TextField fx:id="email" promptText="Email *" styleClass="input" maxWidth="350"/>
            <PasswordField fx:id="password" promptText="Heslo *" styleClass="input" maxWidth="350"/>
            <PasswordField fx:id="confirmPassword" promptText="Heslo znovu *" styleClass="input" maxWidth="350"/>
            <Text text="Heslo musí obsahovat alespoň 8 znáků, číslo, velké i malé písmeno a speciální znak."
                  styleClass="explanation" wrappingWidth="350" textAlignment="CENTER"/>
            <Text text="Vyberte vyučované předměty * (Ctrl + Klik)" styleClass="label"/>

            <ListView fx:id="subjects" maxWidth="350" styleClass="input-list-view"/>

            <CheckBox fx:id="confirmationCheckbox" text="Četl(a) jsem Manuál aplikace *" styleClass="checkbox" maxWidth="350"/>

            <Button fx:id="registerButton" text="Registrovat" onAction="#onRegister" styleClass="submit" maxWidth="350"/>
        </VBox>
    </VBox>
</StackPane>