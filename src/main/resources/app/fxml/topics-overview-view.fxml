<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ListView?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>
<StackPane styleClass="background" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.TopicsOverviewController">
    <VBox alignment="TOP_CENTER" prefHeight="950" prefWidth="650" styleClass="form-container">
        <!-- Horizontal Navigation -->
        <VBox alignment="CENTER" spacing="10">
            <HBox alignment="CENTER" spacing="10" styleClass="horizontal-menu">
                <Button onAction="#onGoToMain" styleClass="menu-button" text="Generovat test" />
                <Button onAction="#onGoToTopics" styleClass="menu-button" text="Přidat téma" />
                <Button styleClass="menu-button-active" text="Přehled témat" />
                <Button onAction="#onGoToEditProfile" styleClass="menu-button" text="Můj účet" />
            </HBox>
        </VBox>

        <!-- Main content -->
        <VBox alignment="CENTER" prefHeight="723.0">
            <VBox alignment="CENTER" spacing="10" styleClass="form-container">
                <Text styleClass="heading" text="Přehled Vašich tématických celků">
                    <VBox.margin>
                        <Insets bottom="20.0"/>
                    </VBox.margin>
                </Text>

                <HBox alignment="CENTER">
                    <ListView fx:id="topics" prefWidth="500" prefHeight="300" styleClass="input-list-view" />
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
