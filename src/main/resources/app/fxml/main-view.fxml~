<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="app.controllers.MainController" styleClass="background">
    <VBox spacing="10" alignment="CENTER" maxWidth="400" styleClass="form-container">
      <Text text="Generátor Testů" styleClass="heading"/>

      <TextField fx:id="testName" promptText="Název testu" styleClass="input" maxWidth="350"/>
      <TextField fx:id="questionCount" promptText="Počet otázek" styleClass="input" maxWidth="350"/>
      <TextField fx:id="timeLimit" promptText="Časový limit v minutách" styleClass="input" maxWidth="350"/>

      <Button text="Připojte soubor" onAction="#handleFileUpload" styleClass="button" maxWidth="350"/>

      <ComboBox fx:id="difficulty" promptText="--- Vyberte obtížnost ---" styleClass="combobox" maxWidth="350"></ComboBox>

      <ComboBox fx:id="questionType" promptText="--- Vyberte typ otázek ---" styleClass="combobox" maxWidth="350"></ComboBox>

      <ComboBox fx:id="subject" onAction="#handleChosenSubject" promptText="--- Vyberte typ předmět ---" styleClass="combobox" maxWidth="350"></ComboBox>

      <Text fx:id="hint" text="Vyberte předmět než vyberete témata" styleClass="label"/>

      <ListView fx:id="topics" maxWidth="350" styleClass="input-list-view"/>

      <TextArea fx:id="message" promptText="Další specifikace testu" styleClass="textarea" maxWidth="350" prefHeight="150"/>

      <Button onAction="#handleCreateTest" text="Vygeneruj test" styleClass="submit" maxWidth="350"/>
    </VBox>
</StackPane>