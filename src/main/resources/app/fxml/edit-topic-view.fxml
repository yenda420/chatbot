<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<StackPane styleClass="background" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.EditTopicController">
    <VBox fx:id="formContainer" alignment="TOP_CENTER" prefHeight="990" prefWidth="1300" spacing="10" styleClass="form-container">
        <!-- Horizontal Navigation -->
        <HBox fx:id="horizontalMenu" alignment="CENTER" spacing="10" styleClass="horizontal-menu">
            <Button onAction="#onGoToMain" styleClass="menu-button" text="Generovat test" />
            <Button onAction="#onGoToTestsOverview" styleClass="menu-button" text="Přehled testů" fx:id="testsOverviewButton" />
            <Button onAction="#onGoToTopics" styleClass="menu-button" text="Přidat téma" />
            <Button onAction="#onGoToTopicsOverview" styleClass="menu-button" text="Přehled témat" />
            <Button onAction="#onGoToEditProfile" styleClass="menu-button" text="Můj účet" />

            <!-- Logout Button -->
            <Button fx:id="logoutButton" onAction="#onLogout" styleClass="menu-button">
                <graphic>
                    <ImageView fx:id="logoutIcon" fitHeight="24" fitWidth="24" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../../images/logout-white.png" />
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <!-- Main content -->
        <VBox alignment="CENTER" prefHeight="723.0" prefWidth="550.0">
          <VBox alignment="CENTER" spacing="10" styleClass="form-container">
              <Text styleClass="heading" text="Změna tematického celku" />

              <HBox alignment="CENTER_RIGHT" maxWidth="350" styleClass="explanation-container">
                  <Text styleClass="explanation" text="* povinné pole" />
              </HBox>

              <TextField fx:id="topicName" maxWidth="350" promptText="Název tematického celku *" styleClass="input" />
              <ComboBox fx:id="subject" maxWidth="350" promptText="Vyberte předmět *" styleClass="combobox" />
              <CheckBox fx:id="isPrivateCheckbox" text="Je soukromý (zobrazí se pouze Vám)" styleClass="checkbox-left" maxWidth="350"/>

              <Button fx:id="updateTopicButton" maxWidth="350" onAction="#onUpdateTopic" styleClass="submit" text="Aktualizovat Tematický celek" />
          </VBox>
        </VBox>
    </VBox>
</StackPane>
