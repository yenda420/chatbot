<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="app.controllers.RegisterController" styleClass="background">
    <VBox spacing="10" alignment="CENTER" minWidth="400" styleClass="form-container">
        <Text text="Registrace" styleClass="heading"/>

        <Hyperlink text="Máte již účet? Přihlašte se." onAction="#handleLoginLink" styleClass="register-link"/>

        <HBox alignment="CENTER_RIGHT" maxWidth="350" styleClass="explanation-container">
            <Text text="* povinné pole" styleClass="explanation"/>
        </HBox>

        <TextField fx:id="firstName" promptText="Jméno" styleClass="input" maxWidth="350"/>
        <TextField fx:id="lastName" promptText="Příjmení" styleClass="input" maxWidth="350"/>
        <TextField fx:id="email" promptText="Email *" styleClass="input" maxWidth="350"/>
        <PasswordField fx:id="password" promptText="Heslo *" styleClass="input" maxWidth="350"/>
        <PasswordField fx:id="confirmPassword" promptText="Heslo znovu *" styleClass="input" maxWidth="350"/>

        <Text text="Vyberte vyučované předměty *" styleClass="label"/>

        <ListView fx:id="subjects" maxWidth="350" styleClass="input-list-view"/>

        <Button fx:id="registerButton" text="Registrovat" onAction="#handleRegister" styleClass="submit" maxWidth="350"/>
    </VBox>
</StackPane>