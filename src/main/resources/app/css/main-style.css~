.background {
    -fx-background-color: black;
}

.form-container {
    -fx-alignment: center;
    -fx-padding: 20;
}

.input, .button, .submit {
    -fx-background-color: maroon;
    -fx-text-fill: white;
    -fx-background-radius: 20;
    -fx-prompt-text-fill: white;
    -fx-font-size: 16px;
    -fx-padding: 8;
    -fx-cursor: hand;
}

.list-view {
    -fx-background-color: maroon;
    -fx-background-radius: 20;
    -fx-padding: 8;
    -fx-font-size: 16px;
}

.list-view .list-cell {
    -fx-background-color: transparent;  /* Ensures visual consistency */
    -fx-text-fill: white;
}

.list-view .list-cell:selected {
    -fx-background-color: darkred;
    -fx-text-fill: white;
}

.submit {
    -fx-background-color: white;
    -fx-text-fill: black;
}

.textarea {
    -fx-control-inner-background: maroon;
}

.combo-box .list-view {
    -fx-background-color: maroon;
    -fx-background-radius: 20;
    -fx-padding: 10;
}

.combo-box .list-cell {
    -fx-background-color: maroon;
    -fx-text-fill: white;
    -fx-background-radius: 20;
    -fx-padding: 5;
}

.combo-box .list-cell:hover {
    -fx-background-color: darkred;
}

.checkbox {
    -fx-text-fill: white;
    -fx-font-size: 16px;
    -fx-cursor: hand;
}