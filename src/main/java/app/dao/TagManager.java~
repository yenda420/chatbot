package app.dao;

import app.models.Tag;
import app.models.Test;
import app.services.DatabaseService;

import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

public class TagManager {
    private static DatabaseService db;

    public TagManager() {
        db = new DatabaseService();
    }

    public static boolean save(Tag tag) throws SQLException {
        if (db.getConn() != null) {
            if (!DatabaseService.instanceInDatabase("tags", "tag", tag.getTag())) {
                String sql = "INSERT INTO tags (tag) VALUES (?)";

                try (PreparedStatement pstmt = db.getConn().prepareStatement(sql)) {
                    pstmt.setString(1, tag.getTag());
                    pstmt.executeUpdate();
                    System.out.println("[INFO] - Tag '" + tag + "' inserted into database.");
                    return true;
                } catch (SQLException e) {
                    System.err.println("[ERROR] - Failed to insert tag '" + tag + "' into database: " + e.getMessage());
                    return false;
                }
            } else {
                return true;
            }
        }
        return false;
    }

